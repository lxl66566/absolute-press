{
  "name": "absolute-press",
  "version": "0.1.0",
  "description": "Absolute Press — A SolidJS static blog framework with MPA SSG + islands",
  "keywords": [
    "blog",
    "islands",
    "markdown",
    "markdown-it",
    "solidjs",
    "ssg",
    "static-site-generator",
    "unocss"
  ],
  "homepage": "https://github.com/lxl66566/absolute-press#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lxl66566/absolute-press.git"
  },
  "files": [
    "src",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./src/node/index.ts",
  "types": "./src/node/index.ts",
  "exports": {
    ".": {
      "types": "./src/node/index.ts",
      "default": "./src/node/index.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint .",
    "check": "tsc --noEmit --strict --skipLibCheck",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "verify": "pnpm fmt:check && pnpm lint && pnpm check && pnpm test",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@mdit/plugin-container": "^2.0.2",
    "@mdit/plugin-figure": "^1.2.2",
    "@mdit/plugin-footnote": "^1.1.2",
    "@mdit/plugin-img-size": "^1.1.2",
    "@mdit/plugin-katex-slim": "^1.1.3",
    "@mdit/plugin-mark": "^2.1.2",
    "@mdit/plugin-tasklist": "^1.1.3",
    "@shikijs/markdown-it": "^4.5.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.2",
    "shiki": "^4.5.0",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@solidjs/web": "2.0.0-rc.13",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.4",
    "@unocss/preset-wind4": "^66.10.5",
    "linkedom": "^0.18.13",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "playwright": "^1.63.0",
    "simple-git-hooks": "^2.14.0",
    "solid-js": "next",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "unocss": "^66.10.5",
    "vite": "^8.3.3",
    "vite-plugin-solid": "3.0.0-next.27",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@solidjs/web": "2.0.0-rc.13",
    "solid-js": "^2.0.0-rc.0",
    "unocss": "^66.10.5",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "unocss": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@antv/g2plot": "^2.4.35",
    "@docsearch/css": "^5.1.2",
    "@docsearch/js": "^5.1.2",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "mermaid": "^12.1.0",
    "photoswipe": "^5.4.4"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,jsonc,css,html,yml,yaml}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "**/*.md": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c"
}
