{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Node-side sources carry explicit .ts specifiers (plain node ESM
    // type-stripping needs them when the package is imported as 'absolute-press').
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    // solid-js@2.0-rc has no ./jsx-runtime export; JSX types live in
    // @solidjs/web (resolvable at the workspace root because it is a direct
    // devDependency, not via any publicHoistPattern).
    "paths": {
      "solid-js/jsx-runtime": ["./node_modules/@solidjs/web/types/jsx.d.ts"]
    },
    "types": ["vite/client", "node"],
    "noEmit": true,
    "alwaysStrict": true, // force "use strict" in emitted code (implied by strict, kept explicit)
    "exactOptionalPropertyTypes": false, // optional props accept explicit undefined vs missing
    "forceConsistentCasingInFileNames": true, // catch case-mismatched imports early
    "isolatedDeclarations": false, // requires explicit types on every export; off for build speed
    "isolatedModules": true, // every file must compile standalone
    "noFallthroughCasesInSwitch": true, // no implicit case fallthrough
    "noImplicitAny": true, // no implicit any
    "noImplicitOverride": true, // subclass overrides must say override
    "noImplicitReturns": true, // every code path must return
    "noImplicitThis": true, // this must have a declared type
    "noPropertyAccessFromIndexSignature": false, // allow dot access on index signatures
    "strict": true, // the full strict family
    "strictBindCallApply": true, // stricter bind/call/apply signatures
    "strictFunctionTypes": true, // contravariant function parameter types
    "strictNullChecks": true, // null/undefined are distinct types
    "noUncheckedIndexedAccess": true, // index access yields T | undefined
    "noUncheckedSideEffectImports": true, // side-effect imports must resolve
    "useUnknownInCatchVariables": true, // catch variables are unknown
    "verbatimModuleSyntax": true // imports/exports keep their written form
  },
  // The packages/ create-absolute-press template is an independently
  // published artifact with its own tsconfig; its imports do not resolve
  // under the root project, so the root tsc skips it.
  "exclude": ["packages"]
}
